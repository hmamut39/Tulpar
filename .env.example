# Tulpar settings. Copy this file to ".env" and fill in your values.
# ".env" is git-ignored: it never leaves your machine. Variables already set in your
# system environment take precedence over this file.

# OpenAI API key, for generating code (https://platform.openai.com/api-keys).
OPENAI_API_KEY=

# Optional: the OpenAI model to use. Default: gpt-6-astra.
TULPAR_OPENAI_MODEL=

# Figma personal access token (read-only scopes), for reading Figma files.
# Figma → Settings → Security → Personal access tokens.
FIGMA_TOKEN=

# Web page only: invite codes, comma-separated (one per tester, so each can be revoked alone).
# Visitors must enter one before generating. Set them whenever the page is reachable by anyone
# but you: every run spends your OpenAI key. With NODE_ENV=production the server will not start
# without them (TULPAR_PUBLIC=1 overrides, for a page that is open on purpose).
TULPAR_ACCESS_CODES=
# A single code also works (older setting).
TULPAR_ACCESS_CODE=

# Web page limits: per visitor per hour, and for the whole server per day (bounds the OpenAI bill).
TULPAR_RUNS_PER_HOUR=10
TULPAR_RUNS_PER_DAY=100

# Set to 1 only behind a hosting proxy that sets X-Forwarded-For (Fly.io, Render, a load balancer).
TULPAR_TRUST_PROXY=

# ---- Accounts and payments (web page) ----
# Sign in with GitHub: create an OAuth app at https://github.com/settings/developers
# (callback URL: <your site>/auth/github/callback). With these set, visitors get a free trial.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs the session cookie: a long random string, never shared.
TULPAR_SESSION_SECRET=
# The site's public address, e.g. https://tulparsi.com
TULPAR_ORIGIN=
# Free trial and Pro allowances, and the Pro price shown on the page.
TULPAR_TRIAL_GENERATIONS=20
TULPAR_PRO_GENERATIONS=300
TULPAR_PRO_PRICE_LABEL=$29

# Stripe: put your secret key here, then run `node web/src/stripe-setup.ts`; it creates the
# product, price, webhook and billing portal, and fills in the other two.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# PrimeNG 20+ is licensed (PrimeUI). For rendering PrimeNG components without a licence notice, put
# your key here (free Community License for individuals and small teams: https://primeui.dev/licenses/community).
PRIMEUI_LICENSE=
