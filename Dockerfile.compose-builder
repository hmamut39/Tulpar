# The build machine for Kotlin (deploy/compose-builder.ts): the JDK, Gradle and Material 3, compiling generated
# Compose components for the main server. No secrets, no public address. Deploy:
#   flyctl deploy --config fly.compose-builder.toml --remote-only
FROM node:24-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production PORT=8080 TULPAR_JAVA_HOME=/opt/jdk TULPAR_GRADLE_HOME=/opt/gradle HOME=/home/node

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /opt/jdk /opt/gradle && chown node:node /app /opt/jdk /opt/gradle

COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node core/package.json core/package.json
COPY --chown=node:node cli/package.json cli/package.json
COPY --chown=node:node web/package.json web/package.json
COPY --chown=node:node mcp/package.json mcp/package.json
COPY --chown=node:node adapters adapters
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && chown -R node:node /app/node_modules

USER node

# The JDK and Gradle from their releases, their published checksums checked.
ARG JDK_URL=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.13%2B9/OpenJDK21U-jdk_x64_linux_hotspot_21.0.13_9.tar.gz
ARG GRADLE_VERSION=9.8.2
RUN curl -sSL -o /tmp/jdk.tgz "$JDK_URL" \
 && curl -sSL "$JDK_URL.sha256.txt" | cut -d' ' -f1 | sed 's|$|  /tmp/jdk.tgz|' | sha256sum -c - \
 && tar -xzf /tmp/jdk.tgz -C /opt/jdk --strip-components=1 && rm /tmp/jdk.tgz \
 && rm -rf /opt/jdk/lib/src.zip /opt/jdk/jmods \
 && curl -sSL -o /tmp/gradle.zip "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" \
 && curl -sSL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip.sha256" | sed 's|$|  /tmp/gradle.zip|' | sha256sum -c - \
 && unzip -q /tmp/gradle.zip -d /tmp/g && cp -r /tmp/g/gradle-${GRADLE_VERSION}/. /opt/gradle/ && rm -rf /tmp/gradle.zip /tmp/g

COPY --chown=node:node core core
COPY --chown=node:node deploy/compose-builder.ts deploy/warm-compose-builder.ts deploy/
COPY --chown=node:node examples/compose-material examples/compose-material

# Everything downloaded and compiled once, with network: a run compiles only the component, offline.
RUN cd examples/compose-material \
 && /opt/gradle/bin/gradle tulparSources --no-daemon --console=plain \
 && mkdir -p .tulpar/compose/src && node ../../deploy/warm-compose-builder.ts > .tulpar/compose/src/TulparHarness.kt \
 && /opt/gradle/bin/gradle wasmJsBrowserDevelopmentExecutableDistribution --no-daemon --console=plain \
 && rm -rf .tulpar/compose/src

EXPOSE 8080
CMD ["node", "deploy/compose-builder.ts"]
