<section class="order-card pa-4" data-figma-id="900:1">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6" data-figma-id="900:2">@Title</MudText>
        <MudText Typo="Typo.body2" data-figma-id="900:3">@Summary</MudText>
    </MudStack>
</section>

@code {
    /// <summary>The card's heading.</summary>
    [Parameter] public string Title { get; set; } = "Order summary";

    /// <summary>One line about the order.</summary>
    [Parameter] public string Summary { get; set; } = "Two items, ready to ship.";
}
