{
  "adapter": "angular",
  "angular": {
    "packages": [
      "node_modules/primeng"
    ],
    "styleDirs": [
      "node_modules/primeng"
    ],
    "tokens": {
      "runtime": {
        "prefix": "p",
        "modes": {
          "dark": "p-dark"
        }
      }
    },
    "render": {
      "stylesheets": [
        "app.css"
      ],
      "setup": "tulpar.setup.ts"
    }
  }
}
