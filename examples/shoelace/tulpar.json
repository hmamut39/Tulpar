{
  "adapter": "web-components",
  "web-components": {
    "packages": [
      "node_modules/@shoelace-style/shoelace"
    ],
    "tokens": {
      "css": {
        "files": [
          "node_modules/@shoelace-style/shoelace/dist/themes/dark.css",
          "node_modules/@shoelace-style/shoelace/dist/themes/light.css"
        ],
        "prefix": "sl",
        "modes": {
          "light": ".sl-theme-light",
          "dark": ".sl-theme-dark"
        }
      }
    },
    "render": {
      "stylesheets": [
        "node_modules/@shoelace-style/shoelace/dist/themes/dark.css",
        "node_modules/@shoelace-style/shoelace/dist/themes/light.css"
      ],
      "themes": {
        "light": "sl-theme-light",
        "dark": "sl-theme-dark"
      },
      "baseFont": "var(--sl-font-sans)"
    }
  }
}
