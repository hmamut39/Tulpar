{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "core",
    "cli",
    "adapters",
    "web/src",
    "deploy",
    "vitest.config.ts",
    "mcp/src",
    "mcp/test",
    "vscode-extension/test"
  ],
  "exclude": [
    "**/*.template.ts",
    "cli/test/golden/*/**",
    "**/node_modules"
  ]
}
